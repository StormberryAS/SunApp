{
  // Type-checking only. The browser still loads app.js as written: no build step, no emit.
  // index.html loads suncalc.js, cities.js and app.js as classic scripts that share one
  // global scope, so app.js is checked as a script (no import or export) and the two
  // libraries it uses are described by hand in types/. suncalc.js is the vendored SunCalc
  // 1.8.0 and cities.js is generated by GitHub/update_cities.py, so neither is checked.
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "legacy",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": false
  },
  "include": ["app.js", "types/**/*.d.ts"]
}
